# Server
PORT=3000
NODE_ENV=development

# Exact frontend origin. Use the deployed HTTPS Vercel origin in production.
# Multiple explicitly allowed origins may be comma-separated.
FRONTEND_ORIGIN=http://localhost:5173

# Local PostgreSQL. Local development can also use a separate Neon development branch.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/warrantykeep
# Production on Render: use the Neon pooled URL (-pooler in the hostname).
# Example only; copy your actual credentials and hostname from Neon Connect:
# DATABASE_URL="postgresql://ROLE:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Migrations and seeding: use the direct Neon URL (no -pooler) as DATABASE_URL
# in a separate, ignored .env.production.local file.
# Keep other Neon connection parameters and TLS certificate verification enabled.

# Initial Admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

# Development Test User 1
USER1_NAME="User 1"
USER1_EMAIL=user1@example.com
USER1_PASSWORD=replace_with_strong_password

# Development Test User 2
USER2_NAME="User 2"
USER2_EMAIL=user2@example.com
USER2_PASSWORD=replace_with_strong_password

# JWT Secret (at least 32 random bytes; for example: openssl rand -base64 48)
JWT_SECRET=
